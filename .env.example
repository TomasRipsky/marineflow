# =============================================================================
# MarineFlow — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.
#
# Setup:
#   cp .env.example .env
#   # Fill in AIS_API_KEY and adjust ADC_PATH for your OS
# =============================================================================

# --- GCP ---
GCP_PROJECT_ID=marineflow-489815
GCS_BUCKET=marineflow-lake-marineflow-489815

# --- AIS Stream ---
# Get your API key at https://aisstream.io
AIS_API_KEY=
MESSAGE_SOURCE=aisstream_live

# --- Pub/Sub Topics ---
PUBSUB_TOPIC_POSITIONS=vessel-positions
PUBSUB_TOPIC_METADATA=vessel-metadata
PUBSUB_TOPIC_DLQ=dead-letter-queue

# --- Pub/Sub Subscriptions ---
PUBSUB_SUB_POSITIONS=vessel-positions-spark-sub

# --- BigQuery ---
BQ_DATASET_BRONZE=marineflow_bronze
BQ_DATASET_SILVER=marineflow_silver

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2g
SPARK_TRIGGER_INTERVAL=30 seconds

# --- Pipeline ---
PIPELINE_VERSION=1.0.0

# --- ADC (Application Default Credentials)
# Run: gcloud auth application-default login
# Windows:
#   ADC_PATH=C:\Users\<your-user>\AppData\Roaming\gcloud\application_default_credentials.json
# Linux/macOS:
#   ADC_PATH=~/.config/gcloud/application_default_credentials.json
ADC_PATH=C:\Users\<your-user>\AppData\Roaming\gcloud\application_default_credentials.json

# --- PostgreSQL (Airflow + MLflow backend) ---
POSTGRES_USER=marineflow
POSTGRES_PASSWORD=marineflow_dev_password
POSTGRES_DB=marineflow

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=marineflow_dev
