# =============================================================================
# MARINEFLOW — environment template
# Copy to .env and fill in. `docker compose` reads .env automatically for the
# ${VAR} substitutions in docker-compose.yml; the host-side producer reads it
# through python-dotenv.
# =============================================================================

# --- Required ---------------------------------------------------------------
# aisstream.io API key (host producer only)
AIS_API_KEY=

# GCP project that owns the bucket and BigQuery datasets
GCP_PROJECT_ID=your-gcp-project-id

# FULL bucket name = <gcs_bucket_name in terraform.tfvars>-<project id>
GCS_BUCKET=marineflow-lake-your-gcp-project-id

# Path to your Application Default Credentials (gcloud auth application-default login)
ADC_PATH=~/.config/gcloud/application_default_credentials.json

# --- Kafka ------------------------------------------------------------------
# Host-side producer talks to the broker on localhost. The Spark containers get
# kafka:29092 from docker-compose.yml, so this value is NOT used inside Docker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_POSITIONS=vessel-positions
KAFKA_TOPIC_METADATA=vessel-metadata
KAFKA_TOPIC_DLQ=dead-letter-queue

# --- Spark micro-batch size (max Kafka offsets read per 30s trigger) ---------
# Passed through to the containers by docker-compose.yml (default 4000 each).
# The cap per second is value / 30. It must stay above the producer's rate (about 95 messages/s measured on the
# live feed): at the old 1000 (33/s) Bronze fell further behind every minute. See README, "Sizing the micro-batch".
BRONZE_MAX_OFFSETS_PER_TRIGGER=4000
BRONZE_METADATA_MAX_OFFSETS_PER_TRIGGER=4000
SILVER_MAX_OFFSETS_PER_TRIGGER=4000
METADATA_MAX_OFFSETS_PER_TRIGGER=4000

# --- Optional ---------------------------------------------------------------
PIPELINE_VERSION=0.1.0
GRAFANA_ADMIN_PASSWORD=marineflow_dev
