    {
      "type": "stat",
      "title": "Bronze rejects",
      "description": "Share of raw positions that Bronze dropped over the last 15 minutes (invalid coordinates, wrong message type). Shows 'no traffic' while the producer is not sending.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(1 - sum(increase(kafka_topic_partition_current_offset{topic=\"vessel-positions-bronze\"}[15m])) / (sum(increase(kafka_topic_partition_current_offset{topic=\"vessel-positions\"}[15m])) > 0), 0)",
          "legendFormat": "",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "mappings": [],
          "noValue": "no traffic",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
