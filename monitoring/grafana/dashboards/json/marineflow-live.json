    {
      "type": "table",
      "title": "Latest alerts",
      "datasource": {
        "type": "hamedkarbasi93-kafka-datasource",
        "uid": "kafka"
      },
      "description": "The 8 newest alerts raised by the hot path.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "hamedkarbasi93-kafka-datasource",
            "uid": "kafka"
          },
          "topicName": "vessel-alerts",
          "partition": "all",
          "autoOffsetReset": "lastN",
          "lastN": 50,
          "messageFormat": "json",
          "timestampMode": "message"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "topic": true,
              "partition": true,
              "offset": true,
              "key": true,
              "alias": true
            },
            "renameByName": {
              "detected_at": "Detected",
              "alert_type": "Alert",
              "severity": "Severity",
              "mmsi": "MMSI",
              "description": "Detail",
              "latitude": "Lat",
              "longitude": "Lon"
            },
            "indexByName": {
              "detected_at": 0,
              "alert_type": 1,
              "severity": 2,
              "mmsi": 3,
              "description": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Detected",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 8
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "high": {
                        "color": "red",
                        "index": 0
                      },
                      "medium": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "GPS_SPOOFING": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "IMPOSSIBLE_SPEED": {
                        "color": "red",
                        "index": 1
                      },
                      "SUDDEN_ACCELERATION": {
                        "color": "orange",
                        "index": 2
                      },
                      "AIS_GAP": {
                        "color": "yellow",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 6
    },
