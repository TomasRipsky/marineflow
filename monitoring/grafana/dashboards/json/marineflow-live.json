    {
      "type": "geomap",
      "title": "Traffic density (latest Bronze positions)",
      "datasource": {
        "type": "hamedkarbasi93-kafka-datasource",
        "uid": "kafka"
      },
      "description": "The last positions read from vessel-positions-bronze. Hot spots are the busiest shipping lanes.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "hamedkarbasi93-kafka-datasource",
            "uid": "kafka"
          },
          "topicName": "vessel-positions-bronze",
          "partition": "all",
          "autoOffsetReset": "lastN",
          "lastN": 500,
          "messageFormat": "json",
          "timestampMode": "message"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 25,
          "lon": 15,
          "zoom": 2,
          "allLayers": true
